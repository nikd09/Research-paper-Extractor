# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is never shared or committed to git -- each person on the team
# needs their own free Gemini API key(s) here, not a copy of someone
# else's, since the free-tier quota is per-key, not shared.
#
# How to get a free key: https://aistudio.google.com/app/apikey
# (Google account required, no payment info needed for the free tier.)

# At least GEMINI_API_KEY_1 is required. _2 and _4 are optional --
# add them if you have more than one free key, so the pipeline can
# automatically switch to the next one if the first hits its daily
# free-tier limit (see src/providers/key_manager.py).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_4=
